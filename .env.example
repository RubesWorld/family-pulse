# Copy to .env.local and fill in. Anything prefixed NEXT_PUBLIC_ is bundled
# into the browser build — never put a secret behind that prefix.
#
# All of these also need to be set in the Vercel project settings. Setting them
# locally only is the most common cause of "works on my machine, 500 in prod".

# --- Supabase -------------------------------------------------------------
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Same page, "service_role" key. Bypasses Row Level Security — server only.
# Used by the cron job and push sender, which run without a user session.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Web Push (VAPID) -----------------------------------------------------
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Contact address push services use to reach you about problems.
# Optional — defaults to mailto:noreply@familypulse.app
VAPID_EMAIL=mailto:you@example.com

# --- Secrets --------------------------------------------------------------
# Generate each with: openssl rand -hex 32

# Vercel Cron sends this automatically as "Authorization: Bearer $CRON_SECRET"
# once it is set in the project. Without it the weekly question rotation
# returns 500 and never runs.
CRON_SECRET=your-cron-secret

# Guards POST /api/notifications/send.
INTERNAL_API_SECRET=your-internal-api-secret
